namespace rerun.components;

/// The codec used to encode audio stored in [components.AudioChunk].
///
/// Enum values are the big-endian packing of the `WebCodecs` audio codec string
/// (same convention used by [components.VideoCodec]).
///
/// Support of these codecs by the Rerun Viewer is platform dependent.
enum AudioCodec: uint (
    "attr.docs.unreleased",
    "attr.rerun.state": "unstable"
) {
    /// Invalid value. Won't show up in generated types.
    Invalid = 0,

    /// Opus — RFC 6716.
    ///
    /// Streams are expected to contain one or more raw Opus packets per
    /// [components.AudioChunk]. Any sample rate supported by the decoder
    /// (8/12/16/24/48 kHz) is valid. Libopus handles internal resampling to
    /// 48 kHz but the logged [components.AudioSampleRate] is treated as
    /// authoritative for downstream analysis.
    ///
    /// Enum value is the fourcc for `'opus'` (the `WebCodecs` string for Opus) in big endian.
    Opus = 0x6f707573, // b'opus'.hex()

    /// Free Lossless Audio Codec (FLAC).
    ///
    /// Each [components.AudioChunk] is expected to contain one or more complete FLAC frames.
    ///
    /// Enum value is the fourcc for `'flac'` (the `WebCodecs` string for FLAC) in big endian.
    Flac = 0x666c6163, // b'flac'.hex()
}
