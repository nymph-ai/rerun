namespace rerun.components;

/// Marks a chunk as an independent seek target.
///
/// A seekable chunk can be handed to the decoder without replaying any
/// earlier chunk. Default is true for codecs whose segments are always
/// self-contained (e.g. Opus); codecs with inter-frame dependencies should
/// set this false on non-key segments.
struct AudioSeekable (
  "attr.arrow.transparent",
  "attr.docs.unreleased",
  "attr.python.aliases": "bool",
  "attr.python.array_aliases": "bool | npt.NDArray[np.bool_]",
  "attr.rerun.state": "unstable",
  "attr.rust.derive": "Default, Copy, PartialEq, Eq",
  "attr.rust.repr": "transparent"
) {
  is_seekable: rerun.datatypes.Bool (order: 100);
}
