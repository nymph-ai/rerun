namespace rerun.components;

/// A time-bounded, decodable segment of encoded audio.
///
/// A chunk is the fundamental temporal unit of an [archetypes.AudioStream]:
/// each logged row represents one segment that can be handed to the decoder
/// without referencing data from any other row (any cross-segment decoder
/// state is reset at segment boundaries marked by [components.AudioDiscontinuity]
/// or [components.AudioSeekable]).
///
/// The row's timeline timestamp is treated as the presentation timestamp (PTS)
/// of the first sample in the chunk. The number of PCM samples produced per
/// channel is carried alongside in [components.AudioDurationSamples].
table AudioChunk (
  "attr.arrow.transparent",
  "attr.docs.unreleased",
  "attr.python.aliases": "bytes | npt.NDArray[np.uint8]",
  "attr.python.array_aliases": "bytes | npt.NDArray[np.uint8]",
  "attr.rerun.state": "unstable",
  "attr.rust.derive": "PartialEq, Eq",
  "attr.rust.repr": "transparent"
) {
  buffer: rerun.datatypes.Blob (order: 100);
}
